{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":rebaseStalePrs",
    ":enableHelpfulPre-commit",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["kubernetes/system/.*\\.yml$", "kubernetes/apps/.*\\.yml$"],
      "matchStrings": [
        "repoURL: (?<registryUrl>.*?)\\n.*?targetRevision: (?<currentValue>.*?)\\n.*?chart: (?<depName>.*)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "terraform": {
    "enabled": true
  },
  "kubernetes": {
    "enabled": true
  },
  "ansible": {
    "enabled": true
  }
}
