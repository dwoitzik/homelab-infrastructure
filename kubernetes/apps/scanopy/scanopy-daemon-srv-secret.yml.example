apiVersion: v1
kind: Secret
metadata:
  name: scanopy-daemon-srv
  namespace: apps
type: Opaque
stringData:
  SCANOPY_SERVER_URL: "http://scanopy-server.apps.svc.cluster.local:60072"
  # Generated from the Scanopy UI after the server is up: create a Network
  # for 10.0.20.0/24, add a daemon, copy its API key here. See README.md.
  SCANOPY_DAEMON_API_KEY: "REPLACE_ME"
  SCANOPY_NETWORK_ID: "REPLACE_ME"
