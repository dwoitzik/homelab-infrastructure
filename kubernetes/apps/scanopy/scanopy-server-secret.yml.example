apiVersion: v1
kind: Secret
metadata:
  name: scanopy-server
  namespace: apps
type: Opaque
stringData:
  # Same password as kubernetes/system/postgres/user-scanopy.yml.example --
  # CNPG's cluster-scanopy.yml bootstrap secret needs discrete
  # username/password keys, this one needs the full DSN, so the same
  # password ends up typed twice. No secret-composition tooling in this repo
  # to avoid that.
  SCANOPY_DATABASE_URL: "postgres://scanopy:REPLACE_ME@postgres-scanopy-rw.database.svc.cluster.local:5432/scanopy"
