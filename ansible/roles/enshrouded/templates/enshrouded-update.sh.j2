#!/usr/bin/env bash
# Apply a new Enshrouded build, but only when Steam's public buildid changed.
# The server ships no Linux depot, so the Windows one must be requested explicitly.
set -euo pipefail
install_dir="{{ enshrouded_install_dir }}"
steamcmd="{{ enshrouded_steamcmd }}"
user="{{ enshrouded_user }}"
app_id="{{ enshrouded_app_id }}"
state_dir="/var/lib/enshrouded"
buildid_file="$state_dir/current_buildid"

mkdir -p "$state_dir"

installed_buildid() {
  grep -oP '"buildid"\s+"\K[0-9]+' \
    "$install_dir/steamapps/appmanifest_${app_id}.acf" 2>/dev/null | head -1
}

latest_buildid() {
  runuser -u "$user" -- "$steamcmd" \
    +@sSteamCmdForcePlatformType windows \
    +login anonymous \
    +app_info_update 1 \
    +app_info_print "$app_id" \
    +quit 2>/dev/null \
  | awk '
      /^[[:space:]]*"branches"/ { in_branches = 1; next }
      in_branches && /^[[:space:]]*"public"/ { in_public = 1; next }
      in_public && /"buildid"/ { gsub(/[^0-9]/, ""); print; exit }
    '
}

old_buildid="$(cat "$buildid_file" 2>/dev/null || true)"
current_buildid="$(installed_buildid)"

if [ -z "$current_buildid" ]; then
  echo "no appmanifest under $install_dir/steamapps -- skipping update check"
  exit 0
fi

# The manifest only changes when SteamCMD runs, so it cannot detect a new
# build on its own; Steam's public branch is the source of truth.
remote_buildid="$(latest_buildid)"
if [ -z "$remote_buildid" ]; then
  echo "ERROR: Steam returned no public buildid -- skipping update check" >&2
  exit 1
fi

if [ "$remote_buildid" = "$current_buildid" ]; then
  if [ "$old_buildid" != "$current_buildid" ]; then
    echo "$current_buildid" > "$buildid_file"
  fi
  echo "buildid $current_buildid is current -- no action"
  exit 0
fi

echo "buildid changed: installed ${current_buildid:-none} -> Steam $remote_buildid, applying update"

runuser -u "$user" -- "$steamcmd" \
  +@sSteamCmdForcePlatformType windows \
  +force_install_dir "$install_dir" \
  +login anonymous \
  +app_update "$app_id" validate \
  +quit

new_buildid="$(installed_buildid)"
if [ -z "$new_buildid" ]; then
  echo "ERROR: appmanifest missing after update -- the server binary is gone" >&2
  exit 1
fi

if [ "$new_buildid" = "$current_buildid" ]; then
  echo "SteamCMD completed but buildid is still $new_buildid -- not restarting"
  exit 0
fi

echo "$new_buildid" > "$buildid_file"
echo "update applied, buildid now $new_buildid -- restarting server"

systemctl restart enshrouded
