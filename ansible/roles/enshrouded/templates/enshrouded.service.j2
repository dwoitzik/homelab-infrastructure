[Unit]
Description=Enshrouded Dedicated Server (Wine)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ enshrouded_user }}
Group={{ enshrouded_user }}
WorkingDirectory={{ enshrouded_install_dir }}
Environment=WINEDEBUG=-all
Environment=WINEPREFIX={{ enshrouded_home }}/.wine
# xvfb-run: the Windows binary expects a display even headless; Wine aborts
# without one. -a picks a free display; the server itself renders nothing.
ExecStart=/usr/bin/xvfb-run -a /usr/bin/wine {{ enshrouded_install_dir }}/enshrouded_server.exe
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
