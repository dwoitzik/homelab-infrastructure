---
# Media acquisition stack — Sonarr/Radarr/Bazarr/SABnzbd/NZBHydra2/Jellyseerr
#
# Privacy model:
#   SABnzbd  → Eweka directly over SSL (port 563). ISP sees encrypted NNTP
#              traffic to eweka.nl only, not content. No VPN overhead on
#              downloads preserves full line speed and avoids Eweka flagging
#              the account for apparent IP-sharing (a known issue with VPN IPs
#              shared across many subscribers).
#   NZBHydra2 → Tor SOCKS5 (172.28.1.10:9050). Indexer search queries never
#              expose the home IP to NZBGeek/DrunkenSlug/etc. Configured in
#              NZBHydra2's proxy settings with "fail closed" (no fallback to
#              direct) so a Tor outage blocks queries rather than leaking.
#   Everything else (Sonarr/Radarr/Bazarr) communicates only within the
#              media-acq-net bridge — no external internet access needed.
networks:
  media-acq-net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.1.0/24

services:
  tor:
    image: peterdavehello/tor-socks-proxy:latest
    container_name: tor
    networks:
      media-acq-net:
        ipv4_address: 172.28.1.10
    restart: unless-stopped

  nzbhydra2:
    image: lscr.io/linuxserver/nzbhydra2:latest
    container_name: nzbhydra2
    networks:
      - media-acq-net
    environment:
      - PUID={{ media_acquisition_puid }}
      - PGID={{ media_acquisition_pgid }}
      - TZ={{ media_acquisition_tz }}
    volumes:
      - {{ media_acquisition_base_dir }}/nzbhydra2/config:/config
    ports:
      - "5076:5076"
    depends_on:
      - tor
    restart: unless-stopped

  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    networks:
      - media-acq-net
    environment:
      - PUID={{ media_acquisition_puid }}
      - PGID={{ media_acquisition_pgid }}
      - TZ={{ media_acquisition_tz }}
    volumes:
      - {{ media_acquisition_base_dir }}/sabnzbd/config:/config
      - /media:/media
    ports:
      - "8080:8080"
    restart: unless-stopped

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    networks:
      - media-acq-net
    environment:
      - PUID={{ media_acquisition_puid }}
      - PGID={{ media_acquisition_pgid }}
      - TZ={{ media_acquisition_tz }}
    volumes:
      - {{ media_acquisition_base_dir }}/sonarr/config:/config
      - /media:/media
    ports:
      - "8989:8989"
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    networks:
      - media-acq-net
    environment:
      - PUID={{ media_acquisition_puid }}
      - PGID={{ media_acquisition_pgid }}
      - TZ={{ media_acquisition_tz }}
    volumes:
      - {{ media_acquisition_base_dir }}/radarr/config:/config
      - /media:/media
    ports:
      - "7878:7878"
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    networks:
      - media-acq-net
    environment:
      - PUID={{ media_acquisition_puid }}
      - PGID={{ media_acquisition_pgid }}
      - TZ={{ media_acquisition_tz }}
    volumes:
      - {{ media_acquisition_base_dir }}/bazarr/config:/config
      - /media:/media
    ports:
      - "6767:6767"
    restart: unless-stopped

  jellyseerr:
    image: fallenbagel/jellyseerr:latest
    container_name: jellyseerr
    networks:
      - media-acq-net
    environment:
      - TZ={{ media_acquisition_tz }}
      - LOG_LEVEL=info
    volumes:
      - {{ media_acquisition_base_dir }}/jellyseerr/config:/app/config
    ports:
      - "5055:5055"
    restart: unless-stopped
