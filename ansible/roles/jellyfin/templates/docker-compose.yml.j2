---
# Jellyfin with VAAPI hardware transcode via the LXC's /dev/dri/renderD128
# passthrough (see terraform/stacks/proxmox/lxc.tf, ct_srv_jellyfin_01).
# Replaces the software-only k3s Deployment.
services:
  jellyfin:
    image: jellyfin/jellyfin:10.11.11
    container_name: jellyfin
    environment:
      - TZ={{ jellyfin_tz }}
      - JELLYFIN_PublishedServerUrl={{ jellyfin_published_url }}
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    group_add:
      - "992" # render group gid inside the LXC (matches device_passthrough in lxc.tf)
    volumes:
      - {{ jellyfin_base_dir }}/config:/config
      - /jellyfin-cache:/cache
      - /media:/media:ro
    ports:
      - "8096:8096"
    restart: unless-stopped
