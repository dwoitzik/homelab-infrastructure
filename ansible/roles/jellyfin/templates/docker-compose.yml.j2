---
# Jellyfin with VAAPI hardware transcode via the LXC's /dev/dri/renderD128
# passthrough (see terraform/stacks/proxmox/lxc.tf, ct_srv_jellyfin_01).
# Replaces the software-only k3s Deployment.
services:
  jellyfin:
    image: jellyfin/jellyfin:10.11.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db
    container_name: jellyfin
    environment:
      - TZ={{ jellyfin_tz }}
      - JELLYFIN_PublishedServerUrl={{ jellyfin_published_url }}
      # The image points XDG_CACHE_HOME at /cache, so Mesa puts its 0700 shader caches
      # there. /cache sits inside the PBS datastore directory on the host, and PBS
      # garbage collection aborts on any subdirectory it cannot read.
      - XDG_CACHE_HOME=/config/xdg-cache
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    group_add:
      - "992" # render group gid inside the LXC (matches device_passthrough in lxc.tf)
    volumes:
      - {{ jellyfin_base_dir }}/config:/config
      - /jellyfin-cache:/cache
      # rw so Jellyfin can delete/replace media; a :ro mount fails in-app
      # deletion ("ensure Jellyfin has write access to the media folder").
      - /media:/media:rw
    ports:
      - "8096:8096"
    restart: unless-stopped
