server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ loki_push_url | default('http://' ~ monitoring_core_host ~ ':3100/loki/api/v1/push') }}
{% if loki_push_tls_server_name is defined %}
    tls_config:
      server_name: {{ loki_push_tls_server_name }}
{% endif %}

scrape_configs:
  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: {{ inventory_hostname }}
          __path__: /var/log/syslog

  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          host: {{ inventory_hostname }}
          __path__: /var/log/auth.log

  # Docker service discovery, not file tailing: the json-file driver only
  # records attrs for labels/env listed in log-opts, which daemon.json does
  # not set, so the log files carry no container name.
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 30s
    relabel_configs:
      - target_label: job
        replacement: docker
      - target_label: host
        replacement: {{ inventory_hostname }}
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: container
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: stream
