# Standby copy of kubernetes/apps/headscale/config.yml's config.yaml, static
# on disk instead of a ConfigMap. Kept in sync by hand when the primary's
# config changes (ADR-029, item 3) -- flag this drift risk in the failover
# runbook rather than pretending it's automated.
server_url: https://headscale.woitzik.dev
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090

private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

database:
  type: sqlite3
  sqlite:
    path: /var/lib/headscale/db.sqlite

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
    region_id: 999
    region_code: homelab
    region_name: Homelab
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
    ipv4: ""
    ipv6: ""
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 24h

dns:
  magic_dns: true
  base_domain: headscale.net
  nameservers:
    global:
      - 10.0.20.5
  extra_records: []

oidc:
  issuer: "https://auth.woitzik.dev"
  client_id: "headscale"
  # client_secret injected via HEADSCALE_OIDC_CLIENT_SECRET in
  # {{ rpi_ha_standby_compose_root }}/headscale/.env -- not templated here,
  # same one-time manual bootstrap as the identity key files (ADR-029).
  # Also note: Authelia itself lives on the same pve-mgmt-01/k3s cluster
  # this standby exists to survive losing, so OIDC login for *new* device
  # registration will not work during a real failover -- only already-
  # registered devices keep working. See the failover runbook.
  scope: ["openid", "profile", "email"]
  allowed_users:
    - "david@woitzik.dev"

log:
  format: text
  level: info

policy:
  mode: file
  path: /etc/headscale/policy.hujson
