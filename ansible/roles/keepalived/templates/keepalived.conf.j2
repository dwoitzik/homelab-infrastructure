global_defs {
    enable_script_security
    script_user root
}

# Priorities are 150/100, so a failing check (-60) hands the VIP to the peer.
vrrp_script chk_dns {
    script "/etc/keepalived/check_dns.sh"
    interval 3
    timeout 3
    fall 2
    rise 2
    weight -60
}

vrrp_instance VI_1 {
    state {{ "MASTER" if inventory_hostname == 'rpi-srv-01' else "BACKUP" }}
    interface eth0
    virtual_router_id 51
    priority {{ 150 if inventory_hostname == 'rpi-srv-01' else 100 }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    track_script {
        chk_dns
    }

    virtual_ipaddress {
        10.0.20.5/24  # Virtual IP (VIP) for HA services
    }
}
