---
# Managed by Ansible — do not edit manually.
# Template: ansible/roles/adguard/templates/AdGuardHome.yaml.j2
#
# Rebuilt 2026-06-21 from the live, running config (schema_version 34) after
# finding significant drift: AdGuard auto-migrates its own config schema on
# every update, but never writes those changes back here. The previous
# template (schema_version 28) was missing several renamed/added fields and
# three DNS rewrites that had only ever been added live via the web UI.

http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  address: 0.0.0.0:3001
  session_ttl: 30d

users:
  - name: dw
    password: "{{ adguard_ui_password | password_hash('bcrypt') }}"

auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: en
theme: auto

dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  anonymize_client_ip: false
  ratelimit: 0
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
    - 127.0.0.1:5335
  upstream_dns_file: ""
  bootstrap_dns:
    - 9.9.9.10
    - 149.112.112.10
  fallback_dns: []
  upstream_mode: load_balance
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
  cache_enabled: true
  cache_size: 67108864
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: true
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 100
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  # Scoped to exactly the Fritzbox LAN — if left empty, AdGuard treats ALL
  # RFC1918 ranges as "private" and forwards PTR queries for the k3s pod
  # network (10.42.0.0/16) to the Fritzbox too, which can't answer them.
  # Each such query burns a 2s timeout; at cluster scale this becomes a
  # query flood that looks like a DNS outage (incident: 2026-06-19).
  private_networks:
    - 192.168.178.0/24
  use_private_ptr_resolvers: true
  local_ptr_upstreams:
    - 192.168.178.1
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true

tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 784
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false

querylog:
  dir_path: ""
  ignored: []
  interval: 7d
  size_memory: 500
  enabled: true
  ignored_enabled: false
  file_enabled: true

statistics:
  dir_path: ""
  ignored: []
  interval: 7d
  enabled: true
  ignored_enabled: false

filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt
    name: "HaGeZi's Pro DNS Blocklist"
    id: 3

whitelist_filters: []
# Tried a $dnsrewrite custom filter rule here to fix SRV lookups for
# _minecraft._tcp.cobblemon.woitzik.dev (the *.woitzik.dev rewrite above
# intercepts that name too and returns empty for any type it can't answer,
# rather than forwarding upstream) -- loaded without error but had no effect
# on the actual query (confirmed live, dig still got ANSWER: 0). Not chasing
# this further blindly: the real SRV record at Cloudflare is correct and this
# only affects testing the no-port hostname from inside the LAN -- external
# players never hit AdGuard at all. See docs/AUDIT.md if revisited.
user_rules: []

dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false

filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: UTC
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  # These three rewrites previously existed ONLY in the live config (added
  # via web UI at some point) and were never captured here - lost on a
  # from-scratch rebuild until this fix.
  rewrites:
    - domain: "*.woitzik.dev"
      answer: "10.0.20.200"
      enabled: true
    # cobblemon.woitzik.dev is a raw-TCP Minecraft server, not an HTTP service --
    # the wildcard above points everything at the Traefik VIP, which has no route
    # to it (Traefik doesn't proxy this port at all). An explicit, more-specific
    # rewrite takes precedence over the wildcard and points internal clients at
    # the same NPM stream proxy (10.0.30.2) external traffic already goes through,
    # so there's only one path to the backend, not two.
    - domain: cobblemon.woitzik.dev
      answer: "10.0.30.2"
      enabled: true
    - domain: www.woitzik.dev
      answer: "64.29.17.65"
      enabled: true
    - domain: www.woitzik.dev
      answer: "216.198.79.65"
      enabled: true
    - domain: headscale.woitzik.dev
      answer: "10.0.20.200"
      enabled: true
    # photos.woitzik.dev is served via Cloudflare tunnel (proxied).
    # The wildcard above would return 10.0.20.200 (Traefik); these
    # specific rewrites override it with Cloudflare's anycast proxy IPs
    # so internal clients reach the tunnel without going through Traefik.
    - domain: photos.woitzik.dev
      answer: "172.67.137.91"
      enabled: true
    - domain: photos.woitzik.dev
      answer: "104.21.38.184"
      enabled: true
  safe_fs_patterns:
    - /opt/adguardhome/work/data/userfilters/*
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true

clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []

log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false

os:
  group: ""
  user: ""
  rlimit_nofile: 0

schema_version: 34
