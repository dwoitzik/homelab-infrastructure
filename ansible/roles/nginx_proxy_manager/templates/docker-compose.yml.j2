---
services:
  npm:
    image: 'jc21/nginx-proxy-manager:latest@sha256:52b2c59994f3d36acfcf70a1626f29734df0ed8c71bacc0269f78b6f939858bb'
    container_name: npm
    restart: unless-stopped
    network_mode: "{{ npm_network_mode | default('bridge') }}"
{% if npm_network_mode | default('bridge') != 'host' %}
    ports:
      - '80:80'
      - '81:81'
      - '443:443'
{% for p in npm_stream_ports | default([]) %}
      - '{{ p }}'
{% endfor %}
{% endif %}
    volumes:
      - /opt/npm/data:/data
      - /opt/npm/letsencrypt:/etc/letsencrypt
{% if npm_enable_crowdsec | default(false) | bool %}
      # Mount NPM logs read-only for CrowdSec analysis
      - /opt/npm/data/logs:/var/log/npm:ro
{% endif %}
    environment:
      - DISABLE_IPV6=true

{% if npm_enable_crowdsec | default(false) | bool %}
  crowdsec:
    # v1.8.1, matching the crowdsec DaemonSet in the cluster. The stack had
    # drifted to v1.7.8, which predates the v1.8.0 fixes for two unbounded
    # request-body reads in the acquisition datasources.
    image: crowdsecurity/crowdsec:v1.8.1@sha256:0f2523fa61ef507f15d953045cface490cc880670c62f2755ced17524107f71a
    container_name: crowdsec
    restart: unless-stopped
    environment:
      - GID={{ nginx_proxy_manager_docker_gid }}
      - COLLECTIONS=crowdsecurity/nginx crowdsecurity/http-cve crowdsecurity/base-http-scenarios crowdsecurity/linux crowdsecurity/sshd crowdsecurity/whitelist-good-actors
      - LAPI_LISTEN_ADDR=0.0.0.0
      - TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
{% if crowdsec_enroll_key is defined %}
      - ENROLL_KEY={{ crowdsec_enroll_key }}
      - ENROLL_INSTANCE_NAME=ct-dmz-proxy-01
{% endif %}
    volumes:
      - /opt/npm/crowdsec/data:/var/lib/crowdsec/data
      - /opt/npm/crowdsec/config:/etc/crowdsec
      # Read-only access to NPM logs
      - /opt/npm/data/logs:/var/log/npm:ro
      # rsyslog-written (see role tasks -- host ships journald only)
      - /var/log/auth.log:/var/log/auth.log:ro
      - /opt/npm/crowdsec/config/local_api_credentials.yaml:/etc/crowdsec/local_api_credentials.yaml
      - /opt/npm/crowdsec/config/acquis.yaml:/etc/crowdsec/acquis.yaml
    ports:
      - "127.0.0.1:8080:8080"
{% endif %}

{% if npm_enable_scanopy_daemon | default(false) | bool %}
  scanopy-daemon:
    image: ghcr.io/scanopy/scanopy/daemon:v0.16.2@sha256:98cdba02b2b127462cba87c10dacdc5671354e2dd43a124b72f8cfd2dfb4b911
    container_name: scanopy-daemon
    restart: unless-stopped
    # host networking: ARP discovery needs the real NIC on 10.0.30.0/24, a
    # normal bridge container never sees that L2 traffic. NET_RAW+NET_ADMIN
    # (not upstream's default privileged:true, and no Docker-socket mount --
    # see kubernetes/apps/scanopy/scanopy.yml's comment on why not, doubly
    # true on this specific box).
    network_mode: host
    cap_drop:
      - ALL
    cap_add:
      - NET_RAW
      - NET_ADMIN
    environment:
      - SCANOPY_SERVER_URL={{ scanopy_server_url }}
      - SCANOPY_DAEMON_API_KEY={{ scanopy_daemon_api_key }}
      - SCANOPY_NETWORK_ID={{ scanopy_network_id }}
{% endif %}
