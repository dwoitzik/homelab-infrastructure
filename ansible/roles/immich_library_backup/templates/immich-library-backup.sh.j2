#!/usr/bin/env bash
# Snapshot the Immich library to the SSD on {{ immich_library_backup_target_inventory_host }}. Each run is a new
# directory hard-linked against the previous one, so unchanged photos cost no space
# and a deletion in Immich stays recoverable for the retention window.
set -euo pipefail
src="{{ immich_library_backup_source }}"
state="{{ immich_library_backup_state_dir }}/last_snapshot"
prom="{{ immich_library_backup_textfile_dir }}/immich_library_backup.prom"
remote="{{ immich_library_backup_target_user }}@{{ immich_library_backup_target_address }}"
ssh_cmd="ssh -i {{ immich_library_backup_key }} -o BatchMode=yes -o StrictHostKeyChecking=yes"

write_metrics() {
  local ok="$1" bytes="${2:-0}"
  local tmp="$prom.$$"
  {
    echo "# HELP immich_library_backup_success 1 if the last run completed a snapshot."
    echo "# TYPE immich_library_backup_success gauge"
    echo "immich_library_backup_success $ok"
    echo "# HELP immich_library_backup_last_run_timestamp_seconds When the backup last ran."
    echo "# TYPE immich_library_backup_last_run_timestamp_seconds gauge"
    echo "immich_library_backup_last_run_timestamp_seconds $(date +%s)"
    if [ "$ok" = 1 ]; then
      echo "# HELP immich_library_backup_last_success_timestamp_seconds When the backup last succeeded."
      echo "# TYPE immich_library_backup_last_success_timestamp_seconds gauge"
      echo "immich_library_backup_last_success_timestamp_seconds $(date +%s)"
      echo "# HELP immich_library_backup_bytes Size of the backed-up library."
      echo "# TYPE immich_library_backup_bytes gauge"
      echo "immich_library_backup_bytes $bytes"
    elif [ -f "$prom" ]; then
      grep -E '^immich_library_backup_(last_success_timestamp_seconds|bytes) ' "$prom" || true
    fi
  } > "$tmp"
  mv "$tmp" "$prom"
}
trap 'write_metrics 0' ERR

# An unmounted or empty source would produce an empty snapshot.
if ! mountpoint -q "{{ immich_library_backup_source_mount }}" || [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
  echo "source $src is not mounted or empty, refusing to snapshot" >&2
  write_metrics 0
  exit 1
fi

snap="$(date +%Y%m%d-%H%M%S)"
link_dest=()
if [ -s "$state" ]; then
  link_dest=(--link-dest="../$(cat "$state")")
fi

# rrsync on the target confines this key to the mirror root, so paths are relative.
stats=$(rsync -rltH --delete --stats "${link_dest[@]}" -e "$ssh_cmd" "$src"/ "$remote:snapshots/$snap/")
echo "$snap" > "$state"

bytes=$(printf '%s\n' "$stats" | awk -F': ' '/^Total file size/ {gsub(/[^0-9]/, "", $2); print $2}')
write_metrics 1 "${bytes:-0}"
echo "snapshot $snap written to $remote"
