#!/bin/bash
# Offsite backup sync — PBS to Storj (S3)
# Managed by Ansible — do not edit manually

LOGFILE="/var/log/pbs-offsite-sync.log"
BUCKET="{{ pbs_rclone_storj_bucket | default('pbs-backups') }}"

echo "$(date): Start Storj Sync" >> "$LOGFILE"

/usr/bin/rclone sync /mnt/backups storj:$BUCKET \
  --quiet \
  --transfers 8 \
  --checkers 16 \
  --s3-chunk-size 64M

if [ $? -eq 0 ]; then
    echo "$(date): Sync erfolgreich beendet" >> "$LOGFILE"
else
    echo "$(date): Sync FEHLGESCHLAGEN" >> "$LOGFILE"
fi

# Healthcheck ping
curl -fsS -m 10 --retry 5 "{{ pbs_healthcheck_url }}"
