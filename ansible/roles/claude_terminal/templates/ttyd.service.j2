[Unit]
Description=ttyd - Claude Code Web Terminal
After=network.target

[Service]
Type=simple
User={{ ttyd_user }}
WorkingDirectory=/home/{{ ttyd_user }}
Environment="HOME=/home/{{ ttyd_user }}"
Environment="ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}"
Environment="CLAUDE_CONFIG_DIR=/home/{{ ttyd_user }}/.claude"
ExecStart=/usr/local/bin/ttyd \
    --port {{ ttyd_port }} \
    --credential {{ ttyd_credential_user }}:{{ vault_ttyd_password }} \
    --writable \
    /usr/bin/claude \
    --dangerously-skip-permissions
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
