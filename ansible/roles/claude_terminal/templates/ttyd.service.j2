[Unit]
Description=ttyd - Claude Code Web Terminal
After=network.target

[Service]
Type=simple
User={{ claude_terminal_user }}
WorkingDirectory=/home/{{ claude_terminal_user }}
Environment="HOME=/home/{{ claude_terminal_user }}"
Environment="CLAUDE_CONFIG_DIR=/home/{{ claude_terminal_user }}/.claude"
ExecStart=/usr/local/bin/ttyd \
    --port {{ claude_terminal_ttyd_port }} \
    --credential {{ claude_terminal_credential_user }}:{{ vault_claude_ttyd_password }} \
    --writable \
    /usr/local/bin/claude \
    --dangerously-skip-permissions
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
