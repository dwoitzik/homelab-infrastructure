#!/usr/bin/env bash
# Prunes old k3s datastore copies and publishes the newest one's age and size.
set -euo pipefail
dir="{{ k3s_kine_backup_target_root }}"
prom="{{ k3s_kine_backup_target_textfile_dir }}/k3s_kine_backup.prom"

mapfile -t files < <(find "$dir" -maxdepth 1 -type f -name 'state-*.db.zst' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
for f in "${files[@]:{{ k3s_kine_backup_target_keep_min }}}"; do
  if [ -n "$(find "$f" -mtime +{{ k3s_kine_backup_target_retention_days }})" ]; then
    rm -f "$f"
  fi
done

newest_ts=0 newest_bytes=0
if [ -n "${files[0]:-}" ] && [ -f "${files[0]}" ]; then
  newest_ts=$(stat -c %Y "${files[0]}")
  newest_bytes=$(stat -c %s "${files[0]}")
fi
count=$(find "$dir" -maxdepth 1 -type f -name 'state-*.db.zst' | wc -l)

tmp="$prom.$$"
cat > "$tmp" <<PROM
# HELP k3s_kine_backup_newest_timestamp_seconds Modification time of the newest k3s datastore copy on this host.
# TYPE k3s_kine_backup_newest_timestamp_seconds gauge
k3s_kine_backup_newest_timestamp_seconds $newest_ts
# HELP k3s_kine_backup_newest_bytes Compressed size of the newest k3s datastore copy.
# TYPE k3s_kine_backup_newest_bytes gauge
k3s_kine_backup_newest_bytes $newest_bytes
# HELP k3s_kine_backup_copies Number of k3s datastore copies kept.
# TYPE k3s_kine_backup_copies gauge
k3s_kine_backup_copies $count
PROM
chmod 0644 "$tmp"
mv "$tmp" "$prom"
